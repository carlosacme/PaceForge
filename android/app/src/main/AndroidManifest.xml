<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: los enlaces de correo (confirmar cuenta, restablecer
                 contraseña) abren la app en vez del navegador.

                 autoVerify hace que Android compruebe al instalar
                 https://www.runningapexflow.com/.well-known/assetlinks.json; si
                 la comprobacion falla, el enlace sigue abriendo el navegador,
                 que es tambien lo que pasa si la app no esta instalada.

                 pathPrefix acota a /auth/ A PROPOSITO. Con el host a secas, la
                 app se tragaria CUALQUIER enlace al sitio: campañas, precios,
                 politica de privacidad... todo saldria de la web y aterrizaria
                 en el WebView. Aqui solo interesan las rutas de autenticacion.
                 Ojo con la barra final: sin ella "/authors" tambien encajaria. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.runningapexflow.com"
                    android:pathPrefix="/auth/" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notificaciones push nativas (@capacitor/push-notifications). Desde
         Android 13 el permiso hay que pedirlo en tiempo de ejecucion, y sin
         declararlo aqui la peticion se deniega sola sin preguntar al usuario. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ubicacion: la usa el widget de clima via @capacitor/geolocation.
         Sin estos permisos el WebView deniega la peticion sin preguntar y el
         clima caia siempre en las coordenadas de respaldo. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- El GPS no es obligatorio: sin el se usa la ubicacion aproximada de red. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>

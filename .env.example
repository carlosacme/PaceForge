# =============================================================================
# PaceForge / RunningApexFlow — variables de entorno
# Copia a .env (nunca se commitea) y rellena. Nombres EXACTOS que lee el código.
# En Vercel: mismas keys. Las VITE_* se incrustan en el build (hace falta redeploy).
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Frontend (Vite). URL del proyecto + clave pública.
# VITE_SUPABASE_KEY = anon (legacy JWT) o publishable (sb_publishable_…).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_KEY=replace-with-anon-or-publishable-key

# Backend (funciones /api). Preferidas en server.
# SUPABASE_ANON_KEY cae a VITE_SUPABASE_KEY si falta.
# SUPABASE_SERVICE_ROLE_KEY = service_role (legacy JWT) o secret (sb_secret_…).
# analyze-workout (adjust-steps) exige SUPABASE_URL sin fallback a VITE_.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key

# --- Wompi (pagos) ----------------------------------------------------------
# No existe WOMPI_PRIVATE_KEY en el código.
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=replace-with-integrity-secret
WOMPI_EVENTS_SECRET=replace-with-events-secret

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Firebase / FCM (solo backend) ------------------------------------------
# JSON del service account en UNA línea. El cliente web no usa env (va hardcodeado).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=re_xxx

# --- App / cron -------------------------------------------------------------
APP_URL=https://www.runningapexflow.com
CRON_SECRET=replace-with-long-random-string

# --- OpenWeather ------------------------------------------------------------
OPENWEATHER_API_KEY=replace-with-openweather-key

# --- Intervals.icu ----------------------------------------------------------
INTERVALS_CLIENT_ID=replace-with-intervals-client-id
INTERVALS_CLIENT_SECRET=replace-with-intervals-client-secret
INTERVALS_WEBHOOK_SECRET=replace-with-intervals-webhook-secret

# --- Analytics (opcional; build-time) ---------------------------------------
VITE_POSTHOG_KEY=phc_xxx

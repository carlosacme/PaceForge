{
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/api/privacy", "destination": "/privacy.html" },
    { "source": "/eliminar-cuenta", "destination": "/eliminar-cuenta.html" },
    { "source": "/api/eliminar-cuenta", "destination": "/eliminar-cuenta.html" },
    { "source": "/oauth/intervals/callback", "destination": "/api/integrations?action=oauth-callback" },
    { "source": "/api/intervals/webhook", "destination": "/api/integrations?action=icu-webhook" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/send-push?action=remind", "schedule": "0 12 * * *" },
    { "path": "/api/send-push?action=weekly-summary", "schedule": "0 13 * * 1" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
